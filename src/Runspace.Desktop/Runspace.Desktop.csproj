<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NuGetLockFilePath>packages.$(Configuration).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runspace.Core\Runspace.Core.csproj" />
    <ProjectReference Include="..\Runspace.PowerShell\Runspace.PowerShell.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="PoshTools.Iseberg.Editor" Version="[0.0.3]" GeneratePathProperty="true" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgPoshTools_Iseberg_Editor)\LICENSE;$(PkgPoshTools_Iseberg_Editor)\editor-notices.md"
             Link="ThirdPartyNotices\Iseberg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\AvaloniaEdit.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
