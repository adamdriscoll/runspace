<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Runspace.Desktop.ViewModels"
        x:Class="Runspace.Desktop.MainWindow"
        Title="Runspace - Administration Console"
        Width="1200" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu x:Name="MainMenu" Grid.Row="0" Background="{DynamicResource ConsoleChrome}">
      <MenuItem Header="_File">
        <MenuItem Header="Export table..." Click="ExportClick" />
        <Separator />
        <MenuItem Header="E_xit" Click="ExitClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Refresh" InputGesture="F5" Click="RefreshClick" />
        <MenuItem Header="_Stop" Click="StopClick" />
        <Separator />
        <MenuItem Header="Results" Click="ResultsClick" />
        <MenuItem Header="PowerShell _History" Click="HistoryClick" />
        <MenuItem Header="_Diagnostics" Click="DiagnosticsClick" />
        <MenuItem x:Name="HighContrastMenu" Header="High _contrast" ToggleType="CheckBox" Click="HighContrastClick" />
        <Separator />
        <MenuItem x:Name="ResetLayoutMenu" Header="Reset _layout" Click="ResetLayoutClick" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="PowerShell providers" Click="ProvidersClick" />
        <MenuItem Header="Go to provider path..." Click="GoToPathClick" />
        <MenuItem Header="Add provider drive..." Click="AddDriveClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About Runspace" Click="AboutClick" />
      </MenuItem>
    </Menu>
    <Border Grid.Row="1" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="0,1,0,1">
      <DockPanel Margin="5,1">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Runtime}" Foreground="{DynamicResource ConsoleMuted}" VerticalAlignment="Center" Margin="12,0" />
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="BackButton" Classes="toolbar" Content="&lt; Back" ToolTip.Tip="Previous resource (Alt+Left)" Click="BackClick" />
          <Button x:Name="ForwardButton" Classes="toolbar" Content="Forward &gt;" ToolTip.Tip="Next resource (Alt+Right)" Click="ForwardClick" />
          <Border Width="1" Background="{DynamicResource ConsoleBorder}" Margin="5,3" />
          <Button x:Name="RefreshButton" Classes="toolbar" Content="Refresh" ToolTip.Tip="Refresh active resource (F5)" Click="RefreshClick" />
          <Button x:Name="StopButton" Classes="toolbar" Content="Stop" IsEnabled="{Binding IsBusy}" Click="StopClick" />
          <Border Width="1" Background="{DynamicResource ConsoleBorder}" Margin="5,3" />
          <Button x:Name="PropertiesButton" Classes="toolbar" Content="Properties" Click="PropertiesClick" />
          <Button Classes="toolbar" Content="Export..." Click="ExportClick" />
          <Button Classes="toolbar" Content="History" Click="HistoryClick" />
        </WrapPanel>
      </DockPanel>
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="160" MaxWidth="350" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="220" MinWidth="180" MaxWidth="350" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource ConsoleContent}" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="paneHeader">
            <TextBlock Text="Navigation Tree" FontWeight="SemiBold" />
          </Border>
          <TreeView x:Name="NavigationTree" AutomationProperties.Name="Resource navigation" ItemsSource="{Binding Roots}" Margin="0,4" Background="{DynamicResource ConsoleContent}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="NavigationChanged">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="2,2" />
                <Setter Property="MinHeight" Value="23" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="{x:Type vm:NavigationItem}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Description}">
                  <Path Data="{Binding Icon}" Fill="{DynamicResource ConsoleAccent}" Width="14" Height="14" Stretch="Uniform" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter x:Name="NavigationSplitter" Grid.Column="1" ResizeDirection="Columns" Focusable="True"
                    AutomationProperties.Name="Navigation pane width" AutomationProperties.HelpText="Use Left and Right to resize."
                    Background="{DynamicResource ConsoleBorder}" />
      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <TabControl x:Name="DocumentTabs" Grid.Row="0" Margin="0" Padding="0">
          <TabItem Header="Results">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Border Grid.Row="0" MinHeight="28" Background="{DynamicResource ConsoleChrome}" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="0,0,0,1" Padding="7,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="Breadcrumb" Text="{Binding Title}" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}" />
                  <TextBox x:Name="LocationBox" AutomationProperties.Name="Provider path" IsVisible="False" PlaceholderText="Provider path, e.g. C:\ or Env:" KeyDown="LocationKeyDown" />
                  <Button x:Name="GoButton" Grid.Column="1" IsVisible="False" Content="Go" Margin="4,0,0,0" Click="GoClick" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Background="{DynamicResource ConsoleStrip}">
                <TextBox x:Name="FilterBox" AutomationProperties.Name="Filter displayed objects" Margin="6,3" PlaceholderText="Filter displayed objects..." Text="{Binding Filter, Mode=TwoWay}" TextChanged="FilterChanged" />
                <Button x:Name="ColumnsButton" Grid.Column="1" Content="Columns..." Margin="0,3,6,3" Click="ColumnsClick" />
              </Grid>
              <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                        SelectionMode="Extended" HeadersVisibility="Column" AutomationProperties.Name="Result objects"
                        SelectionChanged="ResultSelectionChanged" DoubleTapped="ResultDoubleTapped"
                        PointerPressed="ResultPointerPressed">
                <DataGrid.ContextMenu>
                  <ContextMenu x:Name="ResultContextMenu" Opening="ContextMenuOpening" />
                </DataGrid.ContextMenu>
              </DataGrid>
              <Border x:Name="ResultMessage" Grid.Row="3" Background="{DynamicResource ConsoleWarning}" Padding="8,6" IsVisible="False">
                <TextBlock x:Name="ResultMessageText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="PowerShell History">
            <TextBox AutomationProperties.Name="PowerShell invocation history" Text="{Binding History}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas, monospace" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </TabItem>
          <TabItem Header="Current Script">
            <TextBox AutomationProperties.Name="Current PowerShell script" Text="{Binding Script}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas, monospace" BorderThickness="0" />
          </TabItem>
        </TabControl>
        <Border x:Name="DiagnosticsPane" Grid.Row="1" IsVisible="False" Height="160" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="0,1,0,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="paneHeader">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Classes="toolbar" Padding="4,0" MinHeight="18" Click="HideDiagnosticsClick" />
                <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
              </DockPanel>
            </Border>
            <TextBox AutomationProperties.Name="Invocation diagnostics" Text="{Binding Diagnostics}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>
      </Grid>
      <GridSplitter x:Name="ActionsSplitter" Grid.Column="3" ResizeDirection="Columns" Focusable="True"
                    AutomationProperties.Name="Actions pane width" AutomationProperties.HelpText="Use Left and Right to resize."
                    Background="{DynamicResource ConsoleBorder}" />
      <Border Grid.Column="4" Background="{DynamicResource ConsoleContent}" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="paneHeader">
            <TextBlock Text="Actions" FontWeight="SemiBold" />
          </Border>
          <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource ConsoleStrip}" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding Selection}" Foreground="{DynamicResource ConsoleMuted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <ScrollViewer>
            <StackPanel x:Name="ActionsPanel" Spacing="0" Margin="0,4" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" MinHeight="24" Background="{DynamicResource ConsoleChrome}" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="10,0,2,0" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar DockPanel.Dock="Right" Width="90" Height="10" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="4,3" />
        <TextBlock x:Name="StatusText" Text="{Binding Status}" ToolTip.Tip="{Binding Status}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
