<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Runspace.Desktop.ViewModels"
        x:Class="Runspace.Desktop.MainWindow"
        Title="Runspace - Administration Console"
        Width="1200" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="24,31,*,24">
    <Menu Grid.Row="0" Background="#F0F0F0">
      <MenuItem Header="_File">
        <MenuItem Header="Export table..." Click="ExportClick" />
        <Separator />
        <MenuItem Header="E_xit" Click="ExitClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Refresh" InputGesture="F5" Click="RefreshClick" />
        <MenuItem Header="_Stop" Click="StopClick" />
        <Separator />
        <MenuItem Header="Results" Click="ResultsClick" />
        <MenuItem Header="PowerShell _History" Click="HistoryClick" />
        <MenuItem Header="_Diagnostics" Click="DiagnosticsClick" />
        <Separator />
        <MenuItem Header="Reset layout" Click="ResetLayoutClick" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="PowerShell providers" Click="ProvidersClick" />
        <MenuItem Header="Go to provider path..." Click="GoToPathClick" />
        <MenuItem Header="Add provider drive..." Click="AddDriveClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About Runspace" Click="AboutClick" />
      </MenuItem>
    </Menu>
    <Border Grid.Row="1" BorderBrush="#C7CDD4" BorderThickness="0,1,0,1">
      <DockPanel Margin="5,1">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Runtime}" Foreground="#59636E" VerticalAlignment="Center" Margin="12,0" />
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="BackButton" Classes="toolbar" Content="&lt; Back" ToolTip.Tip="Previous resource (Alt+Left)" Click="BackClick" />
          <Button x:Name="ForwardButton" Classes="toolbar" Content="Forward &gt;" ToolTip.Tip="Next resource (Alt+Right)" Click="ForwardClick" />
          <Border Width="1" Background="#C2C8D0" Margin="5,3" />
          <Button x:Name="RefreshButton" Classes="toolbar" Content="Refresh" ToolTip.Tip="Refresh active resource (F5)" Click="RefreshClick" />
          <Button x:Name="StopButton" Classes="toolbar" Content="Stop" IsEnabled="{Binding IsBusy}" Click="StopClick" />
          <Border Width="1" Background="#C2C8D0" Margin="5,3" />
          <Button Classes="toolbar" Content="Properties" Click="PropertiesClick" />
          <Button Classes="toolbar" Content="Export..." Click="ExportClick" />
          <Button Classes="toolbar" Content="History" Click="HistoryClick" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnDefinitions="220,4,*,4,220">
      <Border Grid.Column="0" Background="White" BorderBrush="#BAC4CE" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="paneHeader">
            <TextBlock Text="Navigation Tree" FontWeight="SemiBold" />
          </Border>
          <TreeView x:Name="NavigationTree" ItemsSource="{Binding Roots}" Margin="0,4" Background="White" SelectionChanged="NavigationChanged">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="2,2" />
                <Setter Property="MinHeight" Value="23" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="{x:Type vm:NavigationItem}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Description}">
                  <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Width="14" Height="14" Stretch="Uniform" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#DCE1E7" />
      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <TabControl x:Name="DocumentTabs" Grid.Row="0" Margin="0" Padding="0">
          <TabItem Header="Results">
            <Grid RowDefinitions="28,32,*,Auto">
              <Border Grid.Row="0" Background="#F4F4F4" BorderBrush="#C6CDD5" BorderThickness="0,0,0,1" Padding="7,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="Breadcrumb" Text="{Binding Title}" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}" />
                  <TextBox x:Name="LocationBox" IsVisible="False" PlaceholderText="Provider path, e.g. C:\ or Env:" KeyDown="LocationKeyDown" />
                  <Button x:Name="GoButton" Grid.Column="1" IsVisible="False" Content="Go" Margin="4,0,0,0" Click="GoClick" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Background="#EDF2F7">
                <TextBox x:Name="FilterBox" Margin="6,3" PlaceholderText="Filter displayed objects..." Text="{Binding Filter, Mode=TwoWay}" TextChanged="FilterChanged" />
                <Button Grid.Column="1" Content="Columns..." Margin="0,3,6,3" Click="ColumnsClick" />
              </Grid>
              <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                        SelectionMode="Extended" HeadersVisibility="Column"
                        SelectionChanged="ResultSelectionChanged" DoubleTapped="ResultDoubleTapped"
                        KeyDown="ResultKeyDown" PointerPressed="ResultPointerPressed">
                <DataGrid.ContextMenu>
                  <ContextMenu x:Name="ResultContextMenu" Opening="ContextMenuOpening" />
                </DataGrid.ContextMenu>
              </DataGrid>
              <Border x:Name="ResultMessage" Grid.Row="3" Background="#FFF4D6" Padding="8,6" IsVisible="False">
                <TextBlock x:Name="ResultMessageText" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="PowerShell History">
            <TextBox Text="{Binding History}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas, monospace" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </TabItem>
          <TabItem Header="Current Script">
            <TextBox Text="{Binding Script}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas, monospace" BorderThickness="0" />
          </TabItem>
        </TabControl>
        <Border x:Name="DiagnosticsPane" Grid.Row="1" IsVisible="False" Height="160" BorderBrush="#BAC4CE" BorderThickness="0,1,0,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="paneHeader">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Classes="toolbar" Padding="4,0" MinHeight="18" Click="HideDiagnosticsClick" />
                <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
              </DockPanel>
            </Border>
            <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>
      </Grid>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#DCE1E7" />
      <Border Grid.Column="4" Background="White" BorderBrush="#BAC4CE" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="paneHeader">
            <TextBlock Text="Actions" FontWeight="SemiBold" />
          </Border>
          <Border DockPanel.Dock="Top" Padding="10,8" Background="#F6F8FB" BorderBrush="#E1E6EC" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding Selection}" Foreground="#59636E" TextWrapping="Wrap" />
          </Border>
          <ScrollViewer>
            <StackPanel x:Name="ActionsPanel" Spacing="0" Margin="0,4" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="#BEC7D1" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="10,0,2,0" />
        <ProgressBar DockPanel.Dock="Right" Width="90" Height="10" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="4,3" />
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
